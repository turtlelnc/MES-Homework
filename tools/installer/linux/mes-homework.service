[Unit]
Description=MES Homework
After=network.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=mes-homework
Group=mes-homework
WorkingDirectory=/opt/mes-homework
ExecStart=/opt/mes-homework/runtime/node /opt/mes-homework/app/tools/installer/runtime/launch.mjs --service --headless
Restart=on-failure
RestartSec=5
TimeoutStopSec=25
KillMode=mixed
MemoryAccounting=true
MemoryHigh=60%
MemoryMax=75%
MemorySwapMax=0
OOMPolicy=kill
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/mes-homework
StateDirectory=mes-homework
StateDirectoryMode=0700
LimitNOFILE=8192

[Install]
WantedBy=multi-user.target
