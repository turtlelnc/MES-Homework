# Install as /etc/systemd/system/mes-homework.service after adapting paths/user.
# Node >=24 must exist at /usr/bin/node. Put secrets in /etc/mes-homework.env (0600).
[Unit]
Description=MES Homework with API heartbeat supervision
After=network.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=mes-homework
Group=mes-homework
WorkingDirectory=/opt/mes-homework
EnvironmentFile=/etc/mes-homework.env
Environment=NODE_ENV=production
Environment=DATA_DIR=/var/lib/mes-homework
Environment=HOST=127.0.0.1
Environment=UV_THREADPOOL_SIZE=4
ExecStart=/usr/bin/node tools/ops/supervise.mjs
Restart=always
RestartSec=5
TimeoutStopSec=20
KillMode=control-group
MemoryAccounting=true
MemoryHigh=60%
MemoryMax=75%
MemorySwapMax=0
OOMPolicy=kill
TasksMax=128
LimitNOFILE=8192
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
StateDirectory=mes-homework
ReadWritePaths=/var/lib/mes-homework
StandardOutput=journal
StandardError=journal
LogRateLimitIntervalSec=30s
LogRateLimitBurst=200

[Install]
WantedBy=multi-user.target
