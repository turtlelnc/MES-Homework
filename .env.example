PORT=8787
DATA_DIR=./data
APP_SECRET=请替换为至少32位随机字符串
NODE_ENV=production
# 监听地址：127.0.0.1 仅本机访问；0.0.0.0 允许局域网／隧道访问
HOST=127.0.0.1
# Worker/反向代理部署时填写浏览器访问的精确 Origin（无末尾斜杠）
# APP_ORIGIN=https://homework.example.com
# 可选：部署管理员批准的自定义模型 HTTPS Origin，多个用逗号分隔
# PROVIDER_ALLOWED_ORIGINS=https://gateway.example.com
# 反向代理/CDN 部署时设置可信代理层数（如 Cloudflare 后为 1），
# 登录限速才能按真实客户端 IP 计数；直连部署请保持注释状态
# TRUST_PROXY_HOPS=1
# 模型调用滚动限额（正整数）；失败调用也计数，重启不重置
MODEL_STUDENT_HOURLY_LIMIT=20
MODEL_STAFF_HOURLY_LIMIT=120
MODEL_SCHOOL_HOURLY_LIMIT=600
MODEL_SCHOOL_DAILY_LIMIT=3000
# MODEL_SCHOOL_CONCURRENCY=  # 留空：按本机 CPU/cgroup/内存预算计算
# 每个教师/管理员的模型并发；学生仍最多 1。所有模型功能共享这些槽。
# MODEL_STAFF_CONCURRENCY=  # 留空：按本机 CPU/cgroup/内存预算计算

# 全实例模型调用并发；包括同步接口与后台任务。不是金额预算。
# MODEL_GLOBAL_CONCURRENCY=  # 留空：按本机 CPU/cgroup/内存预算计算
# 所有在途内联图片 Base64 字符数合计预算（MiB），不是精确 RSS。
# MODEL_INLINE_BUDGET_MB=  # 留空：按本机 CPU/cgroup/内存预算计算
# 后台 OCR 并发、全局未完成任务上限、每校未完成任务上限
# OCR_CONCURRENCY=  # 留空：按本机 CPU/cgroup/内存预算计算
# OCR_USER_CONCURRENCY=  # 留空：按本机 CPU/cgroup/内存预算计算
OCR_MAX_PENDING=100
OCR_SCHOOL_MAX_PENDING=25
# 单次上传所有附件的合计上限（MB）；单文件仍最多 20 MB，最多 10 个
UPLOAD_TOTAL_MB=50

# 可选设备端照片切片：默认关闭；需同时配置下方账户/学校费用上限和模型价格。
CLIENT_TILING_ENABLED=0
# 可选 DeepSeek 官方 Flash 图片临时文件，显式 1 小时过期；默认仍走内联图片。
DEEPSEEK_FILES_ENABLED=0
DEEPSEEK_FILE_SLOTS=128
DEEPSEEK_FILE_STORAGE_MB=128
UPLOAD_MAX_TILES=24
# UPLOAD_CONCURRENCY=  # 留空：按本机 CPU/cgroup/内存预算计算
UPLOAD_TIMEOUT_MS=60000
UPLOAD_IDLE_TIMEOUT_MS=15000
# 内存繁忙时仅拒绝新增上传/模型任务；不杀正在处理的正常请求。
# SERVICE_RSS_SOFT_MB=  # 留空：按本机 CPU/cgroup/内存预算计算
SYSTEM_PRESSURE_ENABLED=1
# SQLite 同步锁等待有界，避免请求主线程连续等待数秒。
SQLITE_BUSY_TIMEOUT_MS=0
# HTTP_MAX_CONNECTIONS=  # 留空：由请求预算和内存预算计算
# 上游总时长、收到响应头后读取正文的无进展时长、JSON 响应字节上限。
MODEL_REQUEST_TIMEOUT_MS=60000
# 非流式生成可能先返回响应头再等待正文；此值默认与请求总超时相同。
MODEL_RESPONSE_IDLE_MS=60000
MODEL_RESPONSE_MAX_BYTES=2097152
# UPLOAD_SCRATCH_MB=  # 留空：从目标文件系统实际空间计算
# UPLOAD_SCHOOL_SCRATCH_MB=  # 留空：从目标文件系统实际空间计算
UPLOAD_USER_DAILY_LIMIT=30
UPLOAD_SCHOOL_DAILY_LIMIT=500
UPLOAD_GLOBAL_DAILY_LIMIT=10000
UPLOAD_IP_REQUESTS_PER_MINUTE=600
UPLOAD_USER_HOURLY_PARTS=180
UPLOAD_SCHOOL_HOURLY_PARTS=3000
UPLOAD_GLOBAL_HOURLY_PARTS=6000
UPLOAD_USER_DAILY_MB=300
UPLOAD_SCHOOL_DAILY_MB=3072
UPLOAD_GLOBAL_DAILY_MB=8192
# 金额单位为微元人民币：1000000 = 1 元；两项为 0 时维持原有次数限额。
# 只配置一项或启用后缺少模型价格会拒绝模型调用，不能据此视为已开启费用封顶。
MODEL_SCHOOL_DAILY_MICRO_CNY=0
MODEL_USER_DAILY_MICRO_CNY=0
# 单次批改的模型输出上限，默认 214K（219136）。8192 会在长答卷批改完成前
# 触发截断；上限受 MODEL_RESPONSE_MAX_BYTES 与供应商支持的 max_tokens 约束。
MODEL_MAX_OUTPUT_TOKENS=219136
# 预设模型还会按供应商文档的输出上限再收敛一次（如 claude-sonnet-4-5 为 64K），
# 避免 max_tokens 超过模型支持而被上游拒绝；自定义模型沿用上面的值。
# 需要按模型覆盖时填写，键为 "provider/model"、值为正整数：
# MODEL_OUTPUT_LIMITS_JSON={"qwen/qwen-vl-max":32768,"openai/my-deployment":65536}
# 每个准确 provider/model 的 input、output 单位为“微元/百万 tokens”。
# 必须由管理员按当前价格和保守上界填写；所有视觉模型均须填 imageTokens。
MODEL_COST_RATES_JSON={}

# 备份由独立的 systemd timer 或 backup:run 执行；设置变量不会自动安装定时任务。
# 必须在 DATA_DIR 外，建议使用另一磁盘；留空时拒绝运行备份。
BACKUP_DIR=
BACKUP_KEEP_RECENT=24
BACKUP_KEEP_DAYS=7
# 成功保留的快照总大小上限；临时备份/恢复演练还需额外空间。
# BACKUP_MAX_TOTAL_MB=  # 留空：从目标文件系统实际空间计算
# BACKUP_MAX_SNAPSHOT_MB=  # 留空：从目标文件系统实际空间计算
# BACKUP_MIN_FREE_MB=  # 留空：从目标文件系统实际空间计算
BACKUP_RESTORE_DRILL_DAYS=7
# ── v0.2.1 账号与注册 ──────────────────────────────────────────────
# 公开注册开关：1（默认）= 允许学校/老师/学生/家长凭学校代码自助注册；
# 设为 0 时老师/学生/家长只能由学校管理员创建，学校注册不受影响。
ALLOW_PUBLIC_REGISTRATION=1
# 学校注册需要一次性开通码（默认开启）：先运行
#   npm run school:invite -- create --count 5 --note "某某中学" --days 30
# 把码发给学校，一码一校、注册即核销。本地开发或演示可设为 0 恢复开放注册。
SCHOOL_INVITE_REQUIRED=1

# v0.2.2-rc1 已移除 OAuth，仅通过设置页面配置 API Key。

# 可选覆盖自动预算（正整数 MiB / 并发）；不配置则读取实际环境。
# SERVICE_HEAP_MB=
# PARSER_HEAP_MB=
# PARSER_RSS_MB=
# PASSWORD_CONCURRENCY=
# HTTP_MAX_ACTIVE_REQUESTS=
# DISK_MIN_FREE_MB=
